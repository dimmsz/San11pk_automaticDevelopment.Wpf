<Window x:Class="San11pk_automaticDevelopment.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="三國志11PK 奉行操作テスト" Width="770" Height="740"
        MinWidth="640" MinHeight="540"
        SourceInitialized="Window_SourceInitialized" Closing="Window_Closing"
        FontFamily="Yu Gothic UI" Background="#F7F8FA">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="18">
            <TextBlock Text="三國志11PK｜自動内政 操作テスト" FontSize="23" FontWeight="Bold"/>
            <TextBlock Text="まずは画面座標の記録と右クリック→内政→募兵→実行を検証します。ゲーム本体は変更しません。"
                       Margin="0,7,0,14" Foreground="#555B66" TextWrapping="Wrap"/>
            <Border Background="#FFF2E8" Padding="11" CornerRadius="6" Margin="0,0,0,14">
                <TextBlock Text="実ゲーム未検証の試作品です。最初はドライランで確認し、実際のクリック操作は必ずゲーム画面を見ながら行ってください。"
                           TextWrapping="Wrap"/>
            </Border>

            <TextBlock Text="対象ゲーム" FontWeight="Bold" FontSize="16"/>
            <StackPanel Orientation="Horizontal" Margin="0,7,0,4">
                <TextBlock Text="プロセス名（.exe省略可）" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBox x:Name="ProcessNameTextBox" Text="San11WPK" Width="190" Padding="6,4"/>
            </StackPanel>
            <TextBlock Text="ゲームが最前面のときに Ctrl+Shift+数字キーでカーソル位置を記録します（クリックはしません）。"
                       Foreground="#555B66" Margin="0,5,0,10" TextWrapping="Wrap"/>

            <Border Background="White" BorderBrush="#DDE2E9" BorderThickness="1" CornerRadius="6" Padding="12">
                <StackPanel>
                    <TextBlock Text="座標キャリブレーション（ゲーム描画領域からの相対位置）" FontWeight="Bold" Margin="0,0,0,10"/>
                    <Grid Margin="0,0,0,7">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="245"/><ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Ctrl+Shift+1　① 右クリック位置"/>
                        <TextBlock x:Name="Step1Text" Grid.Column="1" Text="未設定"/>
                    </Grid>
                    <Grid Margin="0,0,0,7">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="245"/><ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Ctrl+Shift+2　②「内政」"/>
                        <TextBlock x:Name="Step2Text" Grid.Column="1" Text="未設定"/>
                    </Grid>
                    <Grid Margin="0,0,0,7">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="245"/><ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Ctrl+Shift+3　③「募兵」"/>
                        <TextBlock x:Name="Step3Text" Grid.Column="1" Text="未設定"/>
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="245"/><ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Ctrl+Shift+4　④「実行」"/>
                        <TextBlock x:Name="Step4Text" Grid.Column="1" Text="未設定"/>
                    </Grid>
                    <TextBlock x:Name="ResolutionText" Text="基準サイズ：未設定" Foreground="#555B66" Margin="0,12,0,0"/>
                    <Button Content="キャリブレーションを消去" Click="ClearCalibration_Click"
                            HorizontalAlignment="Left" Padding="12,5" Margin="0,12,0,0"/>
                </StackPanel>
            </Border>

            <TextBlock Text="操作テスト" FontWeight="Bold" FontSize="16" Margin="0,16,0,10"/>
            <StackPanel Orientation="Horizontal">
                <CheckBox x:Name="EnableClickCheckBox" Content="実際にゲームへマウス入力を送信する"
                          VerticalAlignment="Center" Margin="0,0,25,0"/>
                <TextBlock Text="操作間隔（ミリ秒）" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox x:Name="DelayTextBox" Text="700" Width="70" Padding="5,3"/>
            </StackPanel>
            <TextBlock Text="チェックOFFなら座標をログに出力するだけです。ONの場合、ゲームを前面にしてマウスを操作します。"
                       Foreground="#555B66" Margin="0,8,0,10" TextWrapping="Wrap"/>
            <WrapPanel>
                <Button x:Name="RunOneButton" Content="① 右クリックのみ" Click="RunOne_Click" Padding="12,8" Margin="0,0,8,8"/>
                <Button x:Name="RunThreeButton" Content="①～③ 募兵メニューまで" Click="RunThree_Click" Padding="12,8" Margin="0,0,8,8"/>
                <Button x:Name="RunFourButton" Content="①～④ 実行まで" Click="RunFour_Click" Padding="12,8" Margin="0,0,8,8"/>
            </WrapPanel>
            <StackPanel Orientation="Horizontal" Margin="0,3,0,8">
                <Button Content="停止（Ctrl+Shift+0）" Click="Stop_Click" Padding="12,7"/>
                <TextBlock x:Name="RunStateText" Text="待機中" VerticalAlignment="Center" Margin="14,0,0,0"/>
            </StackPanel>
            <TextBlock Text="操作ログ" FontWeight="Bold" FontSize="16" Margin="0,8,0,8"/>
            <TextBox x:Name="LogTextBox" Height="170" IsReadOnly="True"
                     FontFamily="Consolas" FontSize="12" Padding="8"
                     VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"/>
        </StackPanel>
    </ScrollViewer>
</Window>
